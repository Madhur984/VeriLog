# BitForBytes — single-page-app routing for Apache / LiteSpeed (Hostinger)
# React Router owns the URLs; the server must hand every unknown path to
# index.html so deep links (e.g. /career-roadmap, /verilog-playground) load
# instead of 404-ing. Real files on disk (sitemap.xml, robots.txt, /assets/*,
# images, video) are served directly and are NOT rewritten.

# Don't expose directory listings for any folder that lacks an index.
Options -Indexes

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---- Deny source, config and tooling ----
# The repo was once copied into the web root, which served supabase/ migrations,
# .github/ workflows and app source publicly. The deploy only ever ADDS files
# (rsync, no --delete), so leftovers persist and any future slip re-exposes
# them. This is the backstop; the files themselves should not be here.
#
# Deliberately mod_rewrite only — no `Require`/`FilesMatch`. A directive this
# host does not accept would 500 the WHOLE site, and the SPA rules below already
# prove mod_rewrite works here. Note these must come BEFORE the SPA rules, and
# json/wasm/mjs/tar are NOT blocked: paper-data/*.json, the Yosys engine and the
# pdf.js worker are all served.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Source, tooling and vendored trees that are not build output.
  RewriteRule ^(?:frontend|backend|src|supabase|mcp-server|scripts|design-system|contributions|artifacts|mds|bitforbytes-waitlist|node_modules)(?:/|$) - [F,L]

  # Dot-directories and dotfiles (.git, .github, .env, agent scratch dirs).
  # .well-known is exempt so certificate renewal keeps working.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (?:^|/)\.[^/]+ - [F,L]

  # Source and project-note file types. No .md/.map/.ts ships in the build.
  RewriteRule \.(?:ts|tsx|jsx|env|sql|sh|ps1|bat|py|blend|log|lock|md|toml|ini|bak|orig|patch|map)$ - [F,L]

  # Stray manifests and dumps left over from the repo copy.
  RewriteRule (?:^|/)(?:package(?:-lock)?\.json|tsconfig[^/]*\.json|skills-lock\.json|ux_audit_result\.json|remotes\.txt|activity\.pulse|README[^/]*)$ - [F,L]
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /library once shipped its JSON data as a real directory at this exact path.
  # mod_dir then 301s /library -> /library/, and the SPA rule below refuses to
  # rewrite an existing directory, so the route answered 403 (Options -Indexes)
  # instead of loading the app. The data moved to /paper-data, but rsync never
  # deletes, so the stale directory can linger on the server indefinitely.
  # Claim the path for the app explicitly, and stop mod_dir redirecting it, so a
  # leftover directory can never shadow a route again. DirectorySlash Off is safe
  # here because Options -Indexes above already forbids listings.
  RewriteRule ^library/?$ index.html [L]

  # Never rewrite a request that maps to a real file or directory.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Prerendered per-route SEO HTML: serve /career-roadmap -> career-roadmap.html
  # directly (no redirect, clean URL) when that file exists. Non-prerendered
  # routes fall through to the SPA shell below.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Everything else -> the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType application/wasm .wasm
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType text/vtt .vtt
</IfModule>

# ---- Compression (text assets only; media is already compressed) ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml application/wasm text/vtt
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml application/wasm text/vtt
</IfModule>

# ---- Cache policy ----
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML + sitemap stay fresh so deploys and edits show up quickly.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  # Long-lived, versioned/static assets.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/vtt "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build assets never change under the same name -> cache hard.
  <FilesMatch "\.(?:js|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Media can be cached but not treated as immutable (filenames aren't hashed).
  <FilesMatch "\.(?:mp4|webp|avif|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Never cache the app shell.
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
